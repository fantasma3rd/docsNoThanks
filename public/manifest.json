{
  "manifest_version": 3,
  "name": "Docs, No Thanks",
  "version": "0.3.1",
  "description": "Google Classroom attachments, downloaded in one click. No ceremonial trip through Docs required.",
  "content_scripts": [
    {
      "matches": ["https://classroom.google.com/*"],
      "js": ["viewer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://drive.google.com/*"],
      "all_frames": true,
      "js": ["viewer.js"],
      "run_at": "document_idle"
    }
  ]
}
